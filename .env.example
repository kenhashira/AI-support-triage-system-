# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Required. Used to sign sessions and CSRF tokens.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Which AI analyzes tickets: anthropic (default) or gemini.
AI_PROVIDER=anthropic

# Claude: pay-as-you-go. Create a key at https://console.anthropic.com/
# (not needed to run the test suite)
ANTHROPIC_API_KEY=

# Gemini: free tier available (demo data only: Google may use free-tier content
# to improve its products). Key: https://ai.google.dev/gemini-api/docs/api-key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional overrides
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_TIMEOUT_SECONDS=30
# Relative paths resolve inside the git-ignored instance/ folder.
DATABASE_PATH=triage.db

# Abuse / spend controls. Per client address, and a global cap on AI calls.
RATE_LIMIT_PER_MINUTE=10
AI_CALLS_PER_HOUR=200

# Set to true when serving over HTTPS so the session cookie is HTTPS-only.
SESSION_COOKIE_SECURE=false
